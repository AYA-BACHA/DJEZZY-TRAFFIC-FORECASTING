# Data (never commit — regenerate via src/data pipeline)
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Models (re-generated via src.models.train)
models/*.pkl
models/*.joblib
!models/.gitkeep

# Standalone interactive HTML reports (regenerated via src.visualization.plots)
reports/figures/*.html
!reports/figures/.gitkeep

# Large redundant CSV forecast dumps (compact .parquet and .json are retained for dashboard)
reports/forecasts/*.csv
!reports/forecasts/.gitkeep

# Scratch files
*.tmp
*.log
brief_text.txt
pdf_extracted.txt

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Env
.venv/
venv/
.env

# OS / IDE
.DS_Store
.vscode/
.idea/
