# Data (never commit — regenerate via src/data pipeline)
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Models
models/*
!models/.gitkeep

# Reports that are regenerated, not authored
reports/figures/*
reports/metrics/*
reports/forecasts/*
!reports/figures/.gitkeep
!reports/metrics/.gitkeep
!reports/forecasts/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Env
.venv/
venv/
.env

# OS / IDE
.DS_Store
.vscode/
.idea/
